STDERR->autoflush(1);
binmode STDERR, ":encoding(utf8)";

my $db = Hydra::Model::DB->new();
my $notifyAdded = $db->storage->dbh->prepare("notify builds_added, ?");

my $config = getHydraConfig();

my $plugins = [Hydra::Plugin->instantiate(db => $db, config => $config)];

my $dryRun = defined $ENV{'HYDRA_DRY_RUN'};

my $statsdConfig = Hydra::Helper::Nix::getStatsdConfig($config);
$Net::Statsd::HOST = $statsdConfig->{'host'};
$Net::Statsd::PORT = $statsdConfig->{'port'};

alarm 3600; # FIXME: make configurable


sub parseJobName {
    # Parse a job specification of the form `<project>:<jobset>:<job>
    # [attrs]'.  The project, jobset and attrs may be omitted.  The
    # attrs have the form `name = "value"'.
    my ($s) = @_;
    our $key;
    our %attrs = ();
    # hm, maybe I should stop programming Perl before it's too late...
    $s =~ / ^ (?: (?: ($projectNameRE) : )? ($jobsetNameRE) : )? ($jobNameRE) \s*
            (\[ \s* (
              ([\w]+) (?{ $key = $^N; }) \s* = \s* \"
              ([\w\-]+) (?{ $attrs{$key} = $^N; }) \"
            \s* )* \])? $
          /x
        or die "invalid job specifier `$s'";
    return ($1, $2, $3, \%attrs);
}


sub attrsToSQL {
    my ($attrs, $id) = @_;

    my $query = "1 = 1";

    foreach my $name (keys %{$attrs}) {
        my $value = $attrs->{$name};
        $name =~ /^[\w\-]+$/ or die;
        $value =~ /^[\w\-]+$/ or die;
        # !!! Yes, this is horribly injection-prone... (though
        # name/value are filtered above).  Should use SQL::Abstract,
        # but it can't deal with subqueries.  At least we should use
        # placeholders.
        $query .= " and exists (select 1 from buildinputs where build = $id and name = '$name' and value = '$value')";
    }

    return $query;
}


# Fetch a store path from 'eval_substituter' if not already present.
sub getPath {
    my ($storePath) = @_;
    return 1 if machineLocalStore()->isValidPath($storePath);

    my $substituter = $config->{eval_substituter};

    # `nix copy` is given a full path.
    system("nix", "--experimental-features", "nix-command", "copy", "--from", $substituter, "--",
        printStorePath(machineLocalStore()->storeDir, $storePath))
        if defined $substituter;

    return machineLocalStore()->isValidPath($storePath);
}


sub fetchInputBuild {
    my ($db, $project, $jobset, $name, $value) = @_;

    my $prevBuild;

    if ($value =~ /^\d+$/) {
        $prevBuild = $db->resultset('Builds')->find({ id => int($value) });
    } else {
        my ($projectName, $jobsetName, $jobName, $attrs) = parseJobName($value);
        $projectName ||= $project->name;
        $jobsetName ||= $jobset->name;

        my $jobset = $db->resultset('Jobsets')->search(
            {
                name => $jobsetName,
                project => $projectName,
            },
            {}
        )->single;

        # Pick the most recent successful build of the specified job.
        $prevBuild = $db->resultset('Builds')->search(
            { finished => 1, jobset_id => $jobset->get_column('id')
            , job => $jobName, buildStatus => 0 },
            { order_by => "me.id DESC", rows => 1
            , where => \ attrsToSQL($attrs, "me.id") })->single;
    }

    return () if !defined $prevBuild || !getPath(getMainOutput($prevBuild)->path);

    #print STDERR "input `", $name, "': using build ", $prevBuild->id, "\n";

    my $pkgNameRE = "(?:(?:[A-Za-z0-9]|(?:-[^0-9]))+)";
    my $versionRE = "(?:[A-Za-z0-9\.\-]+)";

    my $relName = ($prevBuild->releasename or $prevBuild->nixname);
    my $version;
    $version = $2 if $relName =~ /^($pkgNameRE)-($versionRE)$/;

    my $mainOutput = getMainOutput($prevBuild);

    my $result =
        { storePath => $mainOutput->path
        , id => $prevBuild->id
        , version => $version
        , outputName => $mainOutput->name
        };
    if (machineLocalStore()->isValidPath($prevBuild->drvpath)) {
        $result->{drvPath} = $prevBuild->drvpath;
    }

    return $result;
}


sub fetchInputSystemBuild {
    my ($db, $project, $jobset, $name, $value) = @_;

    my ($projectName, $jobsetName, $jobName, $attrs) = parseJobName($value);
    $projectName ||= $project->name;
    $jobsetName ||= $jobset->name;

    my @latestBuilds = $db->resultset('LatestSucceededForJobName')
        ->search({}, {bind => [$projectName, $jobsetName, $jobName]});

    my @validBuilds = ();
    foreach my $build (@latestBuilds) {
        push(@validBuilds, $build) if getPath(getMainOutput($build)->path);
    }

    if (scalar(@validBuilds) == 0) {
        print STDERR "input `", $name, "': no previous build available\n";
        return ();
    }

    my @inputs = ();

    foreach my $prevBuild (@validBuilds) {
        my $pkgNameRE = "(?:(?:[A-Za-z0-9]|(?:-[^0-9]))+)";
        my $versionRE = "(?:[A-Za-z0-9\.\-]+)";

        my $relName = ($prevBuild->releasename or $prevBuild->nixname);
        my $version;
        $version = $2 if $relName =~ /^($pkgNameRE)-($versionRE)$/;

        my $input =
            { storePath => getMainOutput($prevBuild)->path
            , id => $prevBuild->id
            , version => $version
            , system => $prevBuild->system
            };
        push(@inputs, $input);
    }

    return @inputs;
}


sub fetchInputEval {
    my ($db, $project, $jobset, $name, $value) = @_;

    my $eval;

    if ($value =~ /^\d+$/) {
        $eval = $db->resultset('JobsetEvals')->find({ id => int($value) });
        die "evaluation $eval->{id} does not exist\n" unless defined $eval;
    } elsif ($value =~ /^($projectNameRE):($jobsetNameRE)$/) {
        my $jobset = $db->resultset('Jobsets')->find({ project => $1, name => $2 });
        die "jobset ‘$value’ does not exist\n" unless defined $jobset;
        $eval = getLatestFinishedEval($jobset);
        die "jobset ‘$value’ does not have a finished evaluation\n" unless defined $eval;
    } elsif ($value =~ /^($projectNameRE):($jobsetNameRE):($jobNameRE)$/) {
        my $jobset = $db->resultset('Jobsets')->find({ project => $1, name => $2 });
        die "jobset ‘$1:$2’ does not exist\n" unless defined $jobset;

        $eval = $db->resultset('JobsetEvals')->find(
            { jobset_id => $jobset->id, hasnewbuilds => 1 },
            { order_by => "id DESC", rows => 1
            , where =>
                \ [ # All builds in this jobset should be finished...
                    "not exists (select 1 from JobsetEvalMembers m join Builds b on m.build = b.id where m.eval = me.id and b.finished = 0) "
                    # ...and the specified build must have succeeded.
                    . "and exists (select 1 from JobsetEvalMembers m join Builds b on m.build = b.id where m.eval = me.id and b.job = ? and b.buildstatus = 0)"
                  , [ 'name', $3 ] ]
            });
        die "there is no successful build of ‘$value’ in a finished evaluation\n" unless defined $eval;
    } else {
        die;
    }

    my $jobs = {};
    foreach my $build ($eval->builds) {
        next unless $build->finished == 1 && $build->buildstatus == 0;
        # FIXME: Handle multiple outputs.
        my $out = $build->buildoutputs->find({ name => "out" });
        next unless defined $out;
        # FIXME: Should we fail if the path is not valid?
        next unless machineLocalStore()->isValidPath($out->path);
        $jobs->{$build->get_column('job')} = $out->path;
    }

    return { jobs => $jobs };
}


sub fetchInput {
    my ($plugins, $db, $project, $jobset, $name, $type, $value, $emailresponsible) = @_;
    my @inputs;

    print STDERR "(" . $project->name . ":" . $jobset->name . ") Fetching input `$name` ($type) $value\n";

    if ($type eq "build") {
        @inputs = fetchInputBuild($db, $project, $jobset, $name, $value);
    }
    elsif ($type eq "sysbuild") {
        @inputs = fetchInputSystemBuild($db, $project, $jobset, $name, $value);
    }
    elsif ($type eq "eval") {
        @inputs = fetchInputEval($db, $project, $jobset, $name, $value);
    }
    elsif ($type eq "string" || $type eq "nix") {
        die unless defined $value;
        @inputs = { value => $value };
    }
    elsif ($type eq "boolean") {
        die unless defined $value && ($value eq "true" || $value eq "false");
        @inputs = { value => $value };
    }
    else {
        my $found = 0;
        foreach my $plugin (@{$plugins}) {
            @inputs = $plugin->fetchInput($type, $name, $value, $project, $jobset);
            if (defined $inputs[0]) {
                $found = 1;
                last;
            }
        }
        die "input `$name' has unknown type `$type'." unless $found;
    }

    foreach my $input (@inputs) {
        $input->{type} = $type;
        $input->{emailresponsible} = $emailresponsible;
    }

    return @inputs;
}


sub booleanToString {
    my ($value) = @_;
    return $value;
}


sub buildInputToString {
    my ($input) = @_;
    my $storeDir = machineLocalStore()->storeDir;
    # `builtins.storePath` takes a full path, as does `-I` below: these are
    # Nix's vocabulary, not Hydra's.
    return
        "{ outPath = builtins.storePath " . printStorePath($storeDir, $input->{storePath}) . "" .
        "; inputType = \"" . $input->{type} . "\"" .
        (defined $input->{uri} ? "; uri = \"" . $input->{uri} . "\"" : "") .
        (defined $input->{revNumber} ? "; rev = " . $input->{revNumber} . "" : "") .
        (defined $input->{revision} ? "; rev = \"" . $input->{revision} . "\"" : "") .
        (defined $input->{revCount} ? "; revCount = " . $input->{revCount} . "" : "") .
        (defined $input->{gitTag} ? "; gitTag = \"" . $input->{gitTag} . "\"" : "") .
        (defined $input->{shortRev} ? "; shortRev = \"" . $input->{shortRev} . "\"" : "") .
        (defined $input->{version} ? "; version = \"" . $input->{version} . "\"" : "") .
        (defined $input->{outputName} ? "; outputName = \"" . $input->{outputName} . "\"" : "") .
        (defined $input->{drvPath} ? "; drvPath = builtins.storePath " . printStorePath($storeDir, $input->{drvPath}) . "" : "") .
        ";}";
}


sub inputsToArgs {
    my ($inputInfo) = @_;
    my @res = ();

    foreach my $input (sort keys %{$inputInfo}) {
        push @res, "-I",
            "$input=" . printStorePath(machineLocalStore()->storeDir,
                $inputInfo->{$input}->[0]->{storePath})
            if scalar @{$inputInfo->{$input}} == 1
               && defined $inputInfo->{$input}->[0]->{storePath};

        die "multiple jobset input alternatives are no longer supported"
            if scalar @{$inputInfo->{$input}} != 1;

        my $alt = $inputInfo->{$input}->[0];

        if ($alt->{type} eq "string") {
            push @res, "--argstr", $input, $alt->{value};
        }
        elsif ($alt->{type} eq "boolean") {
            push @res, "--arg", $input, booleanToString($alt->{value});
        }
        elsif ($alt->{type} eq "nix") {
            push @res, "--arg", $input, $alt->{value};
        }
        elsif ($alt->{type} eq "eval") {
            my $s = "{ ";
            # FIXME: escape $_.  But dots should not be escaped.
            $s .= "$_ = builtins.storePath "
                . printStorePath(machineLocalStore()->storeDir, $alt->{jobs}->{$_}) . "; "
                foreach keys %{$alt->{jobs}};
            $s .= "}";
            push @res, "--arg", $input, $s;
        }
        else {
            push @res, "--arg", $input, buildInputToString($alt);
        }
    }

    return @res;
}


# The `nix-eval-jobs` invocation for a jobset. Separate from running it
# because the same arguments describe the evaluation wherever it happens:
# here, or inside the derivation that an evaluation build realises.
# $gcRootsDir is undef when the evaluation runs inside a derivation: the
# path would be meaningless in the sandbox, and the roots are unnecessary
# there because the JSONL output names the instantiated derivations, so
# they are references of the output and live as long as it does.
sub evalJobsCmd {
    my ($inputInfo, $nixExprInputName, $nixExprPath, $flakeRef, $gcRootsDir) = @_;

    my @cmd;

    if (defined $flakeRef) {
        @cmd = ("nix-eval-jobs",
                # Disable the eval cache to prevent SQLite database contention.
                # Since Hydra typically evaluates each revision only once,
                # parallel workers would compete for database locks without
                # providing any benefit from caching.
                "--option", "eval-cache", "false",
                "--flake", $flakeRef,
                "--select", "flake: flake.outputs.hydraJobs or flake.outputs.checks or (throw \"flake does not provide any Hydra jobs or checks\")");
    } else {
        my $nixExprInput = $inputInfo->{$nixExprInputName}->[0]
            or die "cannot find the input containing the job expression\n";

        @cmd = ("nix-eval-jobs",
                "--option", "restrict-eval", "true",
                "<" . $nixExprInputName . "/" . $nixExprPath . ">",
                inputsToArgs($inputInfo));
    }

    push @cmd, ("--gc-roots-dir", $gcRootsDir) if defined $gcRootsDir;
    push @cmd, ("--max-jobs", 1);
    push @cmd, "--meta";
    push @cmd, "--constituents";
    push @cmd, "--force-recurse";
    push @cmd, ("--option", "allow-import-from-derivation", "false") if ($config->{allow_import_from_derivation} // "false") ne "true";
    push @cmd, ("--workers", $config->{evaluator_workers} // 1);
    push @cmd, ("--max-memory-size", $config->{evaluator_max_memory_size} // 4096);

    return @cmd;
}


# Nix source for a derivation that performs the evaluation, rather than
# evaluating here. The arguments are identical either way -- `evalJobsCmd`
# produces them -- so only where they run differs.
#
# Two things make this possible at all. The store paths those arguments
# mention are pulled in with `builtins.storePath`, so the jobset's inputs
# become real inputs of the derivation and appear in the sandbox; Hydra has
# already materialized them, which is why evaluation can be described as a
# derivation in the first place. And the build needs `recursive-nix`,
# because evaluating instantiates derivations and a sandbox has a read-only
# store view.
#
# The output is the JSONL `nix-eval-jobs` writes. That text names the
# derivations it instantiated, so reference scanning makes them references
# of the output: rooting the evaluation build roots them too, and nothing
# needs `--gc-roots-dir`.
# Where the evaluation build writes its jobs, inside the sandbox, and what
# the resulting stream is called. The name is how the stream is found later,
# next to the build's log.
our $EVAL_STREAM_NAME = "eval-jobs";
our $EVAL_STREAM_PATH = "/hydra/eval-jobs";

sub nixString {
    my ($s) = @_;
    $s =~ s/\\/\\\\/g;
    $s =~ s/"/\\"/g;
    $s =~ s/\$\{/\\\${/g;
    return '"' . $s . '"';
}

sub evalDrvExpr {
    my ($jobsetName, $storePaths, $cmd, $streamPath, $systemFeatures, $tee,
        $storeDir, $storeUri) = @_;

    my $name = $jobsetName;
    $name =~ s/[^a-zA-Z0-9._-]/-/g;

    # `"$@"` rather than a quoted command line: the arguments stay separate
    # Nix strings, so Nix's escaping is the only escaping involved.
    #
    # `HOME` is unset in a build, and Nix's own default of /homeless-shelter
    # is not writable, so the evaluator cannot open its eval cache. Point it
    # at the build directory, which is writable and discarded afterwards.
    #
    # The stream is written only if it is actually there. It arrives as a
    # path the builder binds into the sandbox, and an unsandboxed build --
    # which is what a build against a relocated, writable store must be --
    # never gets it. Nothing is lost when it is missing: the stream only ever
    # makes the jobs visible sooner, and `$out` is the answer either way. A
    # build's PATH is minimal, so `tee` is named by absolute path.
    my $script = defined $streamPath
        ? 'set -eu; export HOME="$PWD"; ' .
          'if [ -e "$evalStream" ]; then "$@" | "$tee" "$out" > "$evalStream"; ' .
          'else "$@" > "$out"; fi'
        : 'set -eu; export HOME="$PWD"; "$@" > "$out"';

    my @argv = ("-c", $script, "hydra-eval", @$cmd);
    my $args = join(" ", map { nixString($_) } @argv);
    my $inputs = join(" ", map { "(builtins.storePath " . nixString($_) . ")" } @$storePaths);

    my $expr = "derivation {\n";
    $expr .= "  name = " . nixString("hydra-eval-" . $name) . ";\n";
    $expr .= "  system = builtins.currentSystem;\n";
    $expr .= "  builder = \"/bin/sh\";\n";
    $expr .= "  args = [ $args ];\n";
    # What evaluation needs from the machine is the ability to add paths to
    # the store while it builds, since instantiating is what evaluating does.
    # Under a sandbox that means `recursive-nix`; an unsandboxed build with a
    # writable store already has it, and asking for the feature there only
    # forces a sandbox that cannot be used.
    $expr .= "  requiredSystemFeatures = [ " .
        join(" ", map { nixString($_) } @$systemFeatures) . " ];\n"
        if @$systemFeatures;
    # Which store the evaluation instantiates into. A build gets no
    # `NIX_STORE_DIR`, so a nested Nix falls back to the compile-time
    # `/nix/store` -- and then rejects Hydra's own inputs as "not in the Nix
    # store" whenever Hydra's store is relocated. The logical store dir is
    # the same on every machine Hydra talks to (it has to be, or paths would
    # not be portable between them), so naming it here is machine-independent
    # despite looking like a local detail.
    $expr .= "  NIX_STORE_DIR = " . nixString($storeDir) . ";\n";
    # That alone is not always enough. A nested Nix with no `NIX_REMOTE`
    # resolves `auto`, and an *unsandboxed* build can see the host's real
    # daemon socket -- whose store dir then wins over the setting above. So
    # when there is no `recursive-nix` to configure the build's Nix for us,
    # the store has to be named outright. It must be the builder's store, so
    # this is configuration rather than anything derivable here, and it is
    # normally unset: in production `recursive-nix` does this job.
    $expr .= "  NIX_REMOTE = " . nixString($storeUri) . ";\n"
        if defined $storeUri && $storeUri ne "";
    # Referenced so the inputs are inputs of this derivation, and so appear
    # in the sandbox rather than merely being named by the arguments.
    $expr .= "  jobsetInputs = [ $inputs ];\n";
    if (defined $streamPath) {
        # Asks the builder for an extra output stream at this path, and tells
        # the build where to write it. The builder relays whatever appears
        # there without interpreting it, so the jobs can be watched as they
        # are found rather than only after the build finishes.
        $expr .= "  evalStream = " . nixString($streamPath) . ";\n";
        $expr .= "  hydraStreams = " . nixString("$EVAL_STREAM_NAME=$streamPath") . ";\n";
        # By absolute path: a build does not inherit PATH.
        $expr .= "  tee = " . nixString($tee) . ";\n";
    }
    $expr .= "}\n";
    return $expr;
}


sub evalJobs {
    my ($jobsetName, $inputInfo, $nixExprInputName, $nixExprPath, $flakeRef) = @_;

    print STDERR "($jobsetName) Evaluating...\n";

    my @cmd = evalJobsCmd($inputInfo, $nixExprInputName, $nixExprPath, $flakeRef,
                          getGCRootsDir);

    if (defined $ENV{'HYDRA_DEBUG'}) {
        sub escape {
            my $s = $_;
            $s =~ s/'/'\\''/g;
            return "'" . $s . "'";
        }
        my @escaped = map escape, @cmd;
        print STDERR "evaluator: @escaped\n";
    }

    # Unset NIX_PATH for nix-eval-jobs to ensure reproducible evaluations
    my %env = %ENV;
    delete $env{'NIX_PATH'};

    my $evalProc = IPC::Run::start \@cmd,
            '>', IPC::Run::new_chunker, \my $out,
            '2>', \my $err,
            init => sub { %ENV = %env; };

    return jobsIterFromLines(sub {
        while (1) {
            $evalProc->pump;
            if (!defined $out && !defined $err) {
                $evalProc->finish;
                if ($?) {
                    die "nix-eval-jobs returned " . ($? & 127 ? "signal $?" : "exit code " . ($? >> 8)) . "\n";
                }
                return undef;
            }

            if (defined $err) {
                print STDERR "$err";
                undef $err;
            }

            if (defined $out && $out ne '') {
                my $line = $out;
                undef $out;
                return $line;
            }
        }
    });
}


# Turn a source of JSON lines into the job iterator that the rest of this
# script consumes: call $nextLine for the next line of `nix-eval-jobs`
# output, or undef when there are no more.
#
# The line source is separate from the parsing because there is more than one
# way to obtain those lines. Running `nix-eval-jobs` here is one; reading what
# an evaluation build produced is another, and it must yield exactly the same
# jobs, so the parsing cannot be duplicated.
sub jobsIterFromLines {
    my ($nextLine) = @_;

    return sub {
        while (1) {
            my $out = $nextLine->();
            return unless defined $out;
            next if $out eq '';

            my $job;
            try {
                $job = decode_json($out);
            } catch {
                warn "nix-eval-jobs sent invalid JSON.\n  parse error: $_\n  invalid json: $out\n";
            };
            next unless defined $job;

            # nix-eval-jobs speaks full paths. Strip the store directory
            # here, where its output enters Hydra, so that everything
            # downstream compares and keys on store paths -- notably
            # the `ne` against a build's inflated drvpath, and the
            # constituent lookups, which would otherwise never match.
            my $storeDir = machineLocalStore()->storeDir;
            $job->{drvPath} = parseStorePath($storeDir, $job->{drvPath})
                if defined $job->{drvPath};
            $job->{constituents} = [
                map { parseStorePath($storeDir, $_) } @{$job->{constituents}}
            ] if defined $job->{constituents};
            return $job;
        }
    };
}


# The store path a path belongs to, or undef if it is not in this store.
# `builtins.storePath` takes the path itself, not something inside it, and a
# path from a different store (the evaluator binary, when Hydra's store is
# not the ambient one) cannot be an input at all.
sub storePathRoot {
    my ($path) = @_;
    my $storeDir = machineLocalStore()->storeDir;
    return undef unless $path =~ m{^\Q$storeDir\E/([^/]+)};
    return "$storeDir/$1";
}


# Every materialized store path the evaluation's arguments mention. These
# become inputs of the evaluation derivation, so they are present in the
# sandbox rather than merely named by an argument.
sub inputStorePaths {
    my ($inputInfo) = @_;
    my $storeDir = machineLocalStore()->storeDir;
    my @paths;
    foreach my $input (sort keys %{$inputInfo}) {
        foreach my $alt (@{$inputInfo->{$input}}) {
            push @paths, printStorePath($storeDir, $alt->{storePath})
                if defined $alt->{storePath};
            push @paths, printStorePath($storeDir, $alt->{drvPath})
                if defined $alt->{drvPath};
            if (defined $alt->{jobs}) {
                push @paths, printStorePath($storeDir, $alt->{jobs}->{$_})
                    foreach keys %{$alt->{jobs}};
            }
        }
    }
    my %seen;
    return grep { !$seen{$_}++ } grep { defined } map { storePathRoot($_) } @paths;
}


# Resolve a program to its absolute path, the way the shell would. Done here
# rather than by shelling out so that a failure can say what was searched.
sub findInPath {
    my ($program) = @_;
    return $program if $program =~ m{/};
    for my $dir (split /:/, ($ENV{PATH} // "")) {
        next if $dir eq "";
        my $candidate = "$dir/$program";
        return $candidate if -x $candidate && !-d $candidate;
    }
    die "cannot find $program in PATH ($ENV{PATH})\n";
}


# The jobset that evaluation builds live in. They need a jobset but belong
# to none in particular -- filing them under the jobset being evaluated would
# list them among its jobs -- so they all share one, mirroring the ad-hoc
# jobset the drv-daemon uses for builds with no evaluation.
#
# `enabled = 0` matters: the evaluator selects jobsets with `enabled != 0`,
# so an enabled jobset here would be scheduled for evaluation itself, and
# evaluating it would want to create an evaluation build inside itself.
sub ensureEvalJobset {
    my ($db) = @_;

    $db->resultset('Users')->find_or_create(
        { username => "hydra", fullname => "Hydra", emailaddress => 'hydra@localhost',
          password => "" });

    my $project = $db->resultset('Projects')->find_or_create(
        { name => "hydra", displayname => "Hydra", owner => "hydra",
          description => "Bookkeeping that Hydra does for itself",
          enabled => 1, hidden => 1 });

    return $project->jobsets->find_or_create(
        { name => "evaluations", description => "Evaluations, run as builds",
          nixexprinput => "", nixexprpath => "", emailoverride => "",
          type => 0, enabled => 0, hidden => 1 });
}


# Schedule the evaluation rather than performing it: instantiate the
# derivation that runs `nix-eval-jobs` and queue it like any other build.
#
# This deliberately does not wait. The queue runner is what dispatches
# builds, and blocking here would hold an evaluator slot for as long as the
# build sits in the queue -- and in the test harness, where the queue runner
# only runs after the evaluator exits, it would never finish at all.
#
# The evaluation is finished elsewhere, when the build completes: see
# `JobsetEvals.eval_build`, which is the only link from an evaluation to the
# build that performed it.
sub scheduleEvaluationBuild {
    my ($db, $project, $jobset, $inputInfo, $flakeRef, $argsHash, $checkoutTime) = @_;

    my $jobsetName = $project->name . ":" . $jobset->name;
    print STDERR "($jobsetName) Scheduling the evaluation as a build...\n";

    my @cmd = evalJobsCmd($inputInfo, $jobset->nixexprinput, $jobset->nixexprpath,
                          $flakeRef, undef);
    my @storePaths = inputStorePaths($inputInfo);

    # A build does not inherit PATH, so the evaluator has to be named by its
    # absolute path. Reference it too when it is in this store, so that it and
    # its closure are in the sandbox rather than merely mentioned -- but only
    # then: Hydra's store is not always the ambient one, and a path from
    # another store is not a store path here.
    my $evaluator = findInPath($cmd[0]);
    $cmd[0] = $evaluator;
    my $evaluatorRoot = storePathRoot($evaluator);
    push @storePaths, $evaluatorRoot if defined $evaluatorRoot;

    my @systemFeatures =
        split ' ', ($config->{evaluation_build_system_features} // "recursive-nix");
    # `tee` sends the jobs to the output and to the stream at once. Like the
    # evaluator it has to be named absolutely, and referenced when it is in
    # this store so that it is present in the sandbox.
    my $tee = findInPath("tee");
    my $teeRoot = storePathRoot($tee);
    push @storePaths, $teeRoot if defined $teeRoot;

    my $expr = evalDrvExpr($jobsetName, \@storePaths, \@cmd, $EVAL_STREAM_PATH,
                           \@systemFeatures, $tee,
                           machineLocalStore()->storeDir,
                           $config->{evaluation_build_store_uri});

    print STDERR "evaluation derivation:\n$expr" if defined $ENV{'HYDRA_DEBUG'};

    my $exprFile = File::Temp->new(SUFFIX => ".nix");
    print $exprFile $expr;
    close $exprFile;

    # stdout and stderr are kept apart: nix-instantiate prints warnings (the
    # missing `--add-root`, for one), and folding those into the captured path
    # corrupts it.
    my ($drvPath, $instantiateErr);
    IPC::Run::run([ "nix-instantiate", "$exprFile" ], \undef, \$drvPath, \$instantiateErr)
        or die "instantiating the evaluation derivation failed:\n$instantiateErr";
    chomp $drvPath;

    my $evalJobset = ensureEvalJobset($db);
    my $time = time();

    my $build = $evalJobset->builds->create(
        { timestamp => $time
        , jobset_id => $evalJobset->id
        , job => $jobsetName
        , nixname => "hydra-eval"
        , drvpath => $drvPath
        , system => `nix-instantiate --eval -E builtins.currentSystem` =~ s/^"|"\n?$//gr
        , priority => 100
        , finished => 0
        , iscurrent => 1
        });

    # The queue runner only ever *updates* a build's output rows -- it fills
    # in the path once the build has produced one -- so the row has to exist
    # first. For a job build `checkBuild` inserts it; this build has no job,
    # so insert it here. The single `out` is the JSONL the evaluation
    # produces, and reading it back is the whole point of the build.
    $build->buildoutputs->create({ name => "out", path => undef });

    # A tentative evaluation, pointing at the build that will fill it in. It
    # exists from the start so that the evaluation is visible while it runs;
    # evalTime and hasNewBuilds are placeholders until the build finishes.
    my $ev = $jobset->jobsetevals->create(
        { timestamp => $time
        , checkouttime => $checkoutTime
          # Placeholders. `completed` is left null to say so; the columns
          # below are `not null` and have no honest value yet.
        , evaltime => 0
        , hasnewbuilds => 0
        , hash => $argsHash
        , eval_build => $build->id
        , flake => $flakeRef
        , nixexprinput => $jobset->nixexprinput
        , nixexprpath => $jobset->nixexprpath
        });

    # The inputs are recorded here rather than when the evaluation finishes,
    # because this is where they are known: the run that completes the
    # evaluation is a different process, and re-fetching could see different
    # revisions than the ones actually evaluated.
    foreach my $name (keys %{$inputInfo}) {
        for (my $n = 0; $n < scalar(@{$inputInfo->{$name}}); $n++) {
            my $input = $inputInfo->{$name}->[$n];
            $ev->jobsetevalinputs->create(
                { name => $name
                , altnr => $n
                , type => $input->{type}
                , uri => $input->{uri}
                , revision => $input->{revision}
                , shortrevlength => length($input->{shortRev})
                , value => $input->{value}
                , dependency => $input->{id}
                , path => $input->{storePath} // "" # !!! temporary hack
                , sha256hash => $input->{sha256hash}
                });
        }
    }

    print STDERR "($jobsetName) Evaluation build " . $build->id . " scheduled\n";
    return $build;
}


# Return the most recent evaluation of the given jobset (that
# optionally had new builds), or undefined if no such evaluation
# exists.
sub getPrevJobsetEval {
    my ($db, $jobset, $hasNewBuilds) = @_;
    my ($prevEval) = $jobset->jobsetevals(
        ($hasNewBuilds ? { hasnewbuilds => 1 } : { }),
        { order_by => "id DESC", rows => 1 });
    return $prevEval;
}


# Check whether to add the build described by $buildInfo.
sub checkBuild {
    my ($db, $jobset, $eval, $inputInfo, $buildInfo, $buildMap, $prevEval, $jobOutPathMap, $plugins) = @_;

    my @outputNames = sort keys %{$buildInfo->{outputs}};
    die unless scalar @outputNames;

    # In various checks we can use an arbitrary output (the first)
    # rather than all outputs, since if one output is the same, the
    # others will be as well.
    my $firstOutputName = $outputNames[0];
    my $firstOutputPath = $buildInfo->{outputs}->{$firstOutputName};

    my $jobName = $buildInfo->{attr} or die;
    my $drvPath = $buildInfo->{drvPath} or die;

    my $build;

    $db->txn_do(sub {
        # Don't add a build that has already been scheduled for this
        # job, or has been built but is still a "current" build for
        # this job.  Note that this means that if the sources of a job
        # are changed from A to B and then reverted to A, three builds
        # will be performed (though the last one will probably use the
        # cached result from the first).  This ensures that the builds
        # with the highest ID will always be the ones that we want in
        # the channels.  FIXME: Checking the output paths doesn't take
        # meta-attributes into account.  For instance, do we want a
        # new build to be scheduled if the meta.maintainers field is
        # changed?
        if (defined $prevEval) {
            my $pathOrDrvConstraint = defined $firstOutputPath
                ? { path => $firstOutputPath }
                : { drvPath => $drvPath };

            my ($prevBuild) = $prevEval->builds->search(
                # The "project" and "jobset" constraints are
                # semantically unnecessary (because they're implied by
                # the eval), but they give a factor 1000 speedup on
                # the Nixpkgs jobset with PostgreSQL.
                { jobset_id => $jobset->get_column('id'), job => $jobName,
                  name => $firstOutputName, %$pathOrDrvConstraint },
                { rows => 1, columns => ['id', 'finished', 'drvpath', 'buildstatus'], join => ['buildoutputs'] });
            if (defined $prevBuild) {
                # Same output path but a different drv: repoint and rebuild.
                # Applied after the evaluation transaction (applyDrvPathRepoints)
                # to avoid holding Builds row locks for the whole evaluation.
                my $repoint = $prevBuild->drvpath ne $drvPath;
                $buildMap->{$prevBuild->id} = { id => $prevBuild->id, jobName => $jobName, new => 0, drvPath => $drvPath, repoint => $repoint };

                if ($prevBuild->finished && !$repoint) {
                    $db->storage->dbh->do("notify cached_build_finished, ?", undef, "${\$eval->id}\t${\$prevBuild->id}");
                } else {
                    $db->storage->dbh->do("notify cached_build_queued, ?", undef, "${\$eval->id}\t${\$prevBuild->id}");
                }

                return;
            }
        }

        # Prevent multiple builds with the same (job, outPath) from
        # being added.
        my $prev = $$jobOutPathMap{$jobName . "\t" . $firstOutputPath};
        if (defined $prev) {
            #print STDERR "    already scheduled as build ", $prev, "\n";
            return;
        }

        my $time = time();

        sub getMeta {
            my ($s, $def) = @_;
            return ($s || "") eq "" ? $def : $s;
        }

        sub getMetaStrings {
            my ($v, $k, $acc) = @_;
            my $t = ref $v;

            if ($t eq 'HASH') {
                push @$acc, $v->{$k} if exists $v->{$k};
            } elsif ($t eq 'ARRAY') {
                getMetaStrings($_, $k, $acc) foreach @$v;
            } elsif (defined $v) {
                push @$acc, $v;
            }
        }

        sub getMetaConcatStrings {
            my ($v, $k) = @_;

            my @strings;
            getMetaStrings($v, $k, \@strings);
            return join(", ", @strings) || undef;
        }

        # Add the build to the database.
        $build = $jobset->builds->create(
            { timestamp => $time
            , jobset_id => $jobset->id
            , job => $jobName
            , description => getMeta($buildInfo->{meta}->{description}, undef)
            , license => getMetaConcatStrings($buildInfo->{meta}->{license}, "shortName")
            , homepage => getMeta($buildInfo->{meta}->{homepage}, undef)
            , maintainers => getMetaConcatStrings($buildInfo->{meta}->{maintainers}, "email")
            , maxsilent => getMeta($buildInfo->{meta}->{maxSilent}, undef)
            , timeout => getMeta($buildInfo->{meta}->{timeout}, undef)
            , nixname => $buildInfo->{name}
            , drvpath => $drvPath
            , system => $buildInfo->{system}
            , priority => getMeta($buildInfo->{meta}->{schedulingPriority}, 100)
            , finished => 0
            , iscurrent => 1
            , ischannel => getMeta($buildInfo->{meta}->{isChannel}, 0)
            });

        # Output rows are inserted in bulk by the caller (see populate below);
        # row-at-a-time creates dominate eval insertion time on large jobsets.
        $buildMap->{$build->id} = { id => $build->id, jobName => $jobName, new => 1, drvPath => $drvPath
                                  , outputs => [ map { { build => $build->id, name => $_, path => $buildInfo->{outputs}->{$_} } } @outputNames ] };
        $$jobOutPathMap{$jobName . "\t" . $firstOutputPath} = $build->id;

        $db->storage->dbh->do("notify build_queued, ?", undef, $build->id);
        print STDERR "added build ${\$build->id} (${\$jobset->get_column('project')}:${\$jobset->name}:$jobName)\n";
    });

    return $build;
};


sub fetchInputs {
    my ($project, $jobset, $inputInfo) = @_;
    foreach my $input ($jobset->jobsetinputs->all) {
        foreach my $alt ($input->jobsetinputalts->all) {
            push @{$$inputInfo{$input->name}}, $_
                foreach fetchInput($plugins, $db, $project, $jobset, $input->name, $input->type, $alt->value, $input->emailresponsible);
        }
    }
}


sub setJobsetError {
    my ($jobset, $errorMsg, $errorTime) = @_;
    my $prevError = $jobset->errormsg;

    eval {
        $db->txn_do(sub {
            $jobset->update({ errormsg => $errorMsg, errortime => $errorTime, fetcherrormsg => undef });
        });
    };
    if (defined $errorMsg && $errorMsg ne ($prevError // "") || $ENV{'HYDRA_MAIL_TEST'}) {
        sendJobsetErrorNotification($jobset, $errorMsg);
    }
}


sub sendJobsetErrorNotification() {
    my ($jobset, $errorMsg) = @_;

    chomp $errorMsg;

    return unless $config->{email_notification} // 0;
    return if $jobset->project->owner->emailonerror == 0;
    return if $errorMsg eq "";

    my $projectName = $jobset->get_column('project');
    my $jobsetName = $jobset->name;
    my $body = "Hi,\n"
        . "\n"
        . "This is to let you know that evaluation of the Hydra jobset ‘$projectName:$jobsetName’\n"
        . "resulted in the following error:\n"
        . "\n"
        . "$errorMsg"
        . "\n"
        . "Regards,\n\nThe Hydra build daemon.\n";

    try {
        sendEmail(
            $config,
            $jobset->project->owner->emailaddress,
            "Hydra $projectName:$jobsetName evaluation error",
            $body,
            [ 'X-Hydra-Project' => $projectName
            , 'X-Hydra-Jobset'  => $jobsetName
            ]);
    } catch {
        warn "error sending email: $_\n";
    };
}


sub permute {
    my @list = @_;
    for (my $n = scalar @list - 1; $n > 0; $n--) {
        my $k = int(rand($n + 1)); # 0 <= $k <= $n
        @list[$n, $k] = @list[$k, $n];
    }
    return @list;
}


# Point the jobset's iscurrent flags at the given evaluation, in id-ordered
# batches outside the evaluation transaction: updating 100k+ Builds rows
# inside it holds their locks for minutes and deadlocks against the queue
# runner finishing builds.
sub syncCurrentBuilds {
    my ($jobset, $evalId) = @_;
    my $dbh = $db->storage->dbh;
    my $batch = 10000;

    my $run = sub {
        my ($sql, @bind) = @_;
        while (1) {
            my $n;
            for (my $attempt = 1; ; $attempt++) {
                eval { $n = $dbh->do($sql, undef, @bind); };
                last unless $@;
                die $@ if $attempt >= 10 || $@ !~ /deadlock detected|could not serialize access/i;
                sleep 1;
            }
            last if $n == 0;
        }
    };

    $run->(q{
        update builds set iscurrent = 1 where id in (
          select b.id from builds b join jobsetevalmembers m on m.build = b.id
          where m.eval = ? and b.iscurrent = 0 order by b.id limit ?)
    }, $evalId, $batch);

    $run->(q{
        update builds set iscurrent = 0 where id in (
          select b.id from builds b
          where b.jobset_id = ? and b.iscurrent = 1
            and not exists (select 1 from jobsetevalmembers m where m.eval = ? and m.build = b.id)
          order by b.id limit ?)
    }, $jobset->get_column('id'), $evalId, $batch);
}

# Repoint existing builds at their new derivation in a short id-ordered
# transaction outside the evaluation transaction, so it can't hold Builds row
# locks for the whole evaluation and deadlock the queue runner.
sub applyDrvPathRepoints {
    my ($buildMap) = @_;
    my @ids = sort { $a <=> $b } grep { $buildMap->{$_}->{repoint} } keys %$buildMap;
    return unless @ids;

    my $builds = $db->resultset('Builds');
    for (my $attempt = 1; ; $attempt++) {
        eval {
            $db->txn_do(sub {
                for my $id (@ids) {
                    $builds->search({ id => $id })->update(
                        { drvpath => $buildMap->{$id}->{drvPath}, finished => 0, buildstatus => undef });
                }
            });
        };
        last unless $@;
        die $@ if $attempt >= 10 || $@ !~ /deadlock detected|could not serialize access/i;
        sleep 1;
    }
}

sub checkJobsetWrapped {
    my ($jobset, $tmpId) = @_;
    my $project = $jobset->project;
    my $jobsetsJobset = length($project->declfile) && $jobset->name eq ".jobsets";
    my $inputInfo = {};
    if ($jobsetsJobset) {
        my @declInputs = fetchInput($plugins, $db, $project, $jobset, "decl", $project->decltype, $project->declvalue, 0);
        my $declInput = $declInputs[0] or die "cannot find the input containing the declarative project specification\n";
        die "multiple alternatives for the input containing the declarative project specification are not supported\n"
            if scalar @declInputs != 1;
        my $declFile = printStorePath(machineLocalStore()->storeDir, $declInput->{storePath})
            . "/" . $project->declfile;
        # Use `nix store cat` so the physical store location is resolved
        # by the store itself (handles root= stores where physical != logical).
        my ($res, $declText, $catErr) = captureStdoutStderr(
            60,
            "nix", "--extra-experimental-features", "nix-command",
            "store", "cat", $declFile);
        die "Couldn't read declarative specification file $declFile: $catErr\n" if $res != 0;
        my $declSpec;
        eval {
            $declSpec = decode_json($declText);
        };

        die "Declarative specification file $declFile not valid JSON: $@\n" if $@;

        if (ref $declSpec eq "HASH") {
            my $isStatic = 1;
            foreach my $elem (values %$declSpec) {
                if (ref $elem ne "HASH") {
                    $isStatic = 0;
                    last;
                }
            }
            if ($isStatic) {
                # Since all of its keys are hashes, assume the json document
                # itself is the entire set of jobs
                handleDeclarativeJobsetJson($db, $project, $declSpec);
                $db->txn_do(sub {
                    $jobset->update({ lastcheckedtime => time, fetcherrormsg => undef });
                });
                return;
            } else {
                # Update the jobset with the spec's inputs, and the continue
                # evaluating the .jobsets jobset.
                updateDeclarativeJobset($config, $db, $project, ".jobsets", $declSpec);
                $jobset->discard_changes;
                $inputInfo->{"declInput"} = [ $declInput ];
                $inputInfo->{"projectName"} = [ fetchInput($plugins, $db, $project, $jobset, "projectName", "string", $project->name, 0) ];

            }
        } else {
            die "Declarative specification file $declFile is not a dictionary"
        }
    }

    # Fetch all values for all inputs.
    my $checkoutStart = clock_gettime(CLOCK_MONOTONIC);
    eval {
        fetchInputs($project, $jobset, $inputInfo);
    };
    my $fetchError = $@;

    my $flakeRef = $jobset->flake;
    if (defined $flakeRef) {
        (my $res, my $json, my $stderr) = captureStdoutStderr(
            600, "nix", "flake", "metadata", "--refresh", "--json", "--", $flakeRef);
        die "'nix flake metadata' returned " . ($res & 127 ? "signal $res" : "exit code " . ($res >> 8))
            . ":\n" . ($stderr ? decode("utf-8", $stderr) : "(no output)\n")
            if $res;
        $flakeRef = decode_json($json)->{'url'};
    }

    Net::Statsd::increment("hydra.evaluator.checkouts");
    my $checkoutStop = clock_gettime(CLOCK_MONOTONIC);
    Net::Statsd::timing("hydra.evaluator.checkout_time", int(($checkoutStop - $checkoutStart) * 1000));

    if ($fetchError) {
        Net::Statsd::increment("hydra.evaluator.failed_checkouts");
        print STDERR $fetchError;
        $db->txn_do(sub {
            $jobset->update({ lastcheckedtime => time, fetcherrormsg => $fetchError }) if !$dryRun;
            $db->storage->dbh->do("notify eval_failed, ?", undef, join("\t", $tmpId, $jobset->get_column('id')));
        });
        return;
    }

    # Hash the arguments to nix-eval-jobs and check the
    # JobsetInputHashes to see if the previous evaluation had the same
    # inputs.  If so, bail out.
    my @args = ($jobset->nixexprinput // "", $jobset->nixexprpath // "", inputsToArgs($inputInfo));
    my $argsHash = sha256_hex("@args");
    my $prevEval = getPrevJobsetEval($db, $jobset, 0);
    if (defined $prevEval && $prevEval->hash eq $argsHash && !$dryRun && !$jobset->forceeval && (!defined($flakeRef) || ($prevEval->flake eq $flakeRef))) {
        print STDERR "  jobset is unchanged, skipping\n";
        Net::Statsd::increment("hydra.evaluator.unchanged_checkouts");
        $db->txn_do(sub {
            $jobset->update({ lastcheckedtime => time, fetcherrormsg => undef });
            $db->storage->dbh->do("notify eval_cached, ?", undef, join("\t",
                $tmpId,
                $jobset->get_column('id'),
                $prevEval->get_column('id'))
            );
        });
        return;
    }

    # Evaluate the job expression.
    my $evalStart = clock_gettime(CLOCK_MONOTONIC);
    my $evalStop;
    # Evaluation happens in a build, so that it is scheduled and distributed
    # like any other work. Scheduling it ends this run: the evaluation is
    # finished when that build completes, not here.
    $db->txn_do(sub {
        scheduleEvaluationBuild($db, $project, $jobset, $inputInfo, $flakeRef, $argsHash,
                                abs(int($checkoutStop - $checkoutStart)));
        $jobset->update({ lastcheckedtime => time, fetcherrormsg => undef });
    });
    return;
}


# Finish an evaluation from the jobs its evaluation build produced.
#
# This runs in a different process from the one that scheduled the build,
# so everything it needs is passed in rather than left in scope: the jobs
# iterator, and the context the scheduling run recorded.
sub finishEvaluation {
    my ($db, $plugins, $project, $jobset, $evalId, $jobsIter, $evalSeconds,
        $tmpId, $dryRun) = @_;

    # Recomputed rather than threaded through: it is a property of the
    # project and jobset, both of which are already here.
    my $jobsetsJobset = length($project->declfile) && $jobset->name eq ".jobsets";

    if ($dryRun) {
        while (defined(my $job = $jobsIter->())) {
            my $name = $job->{attr};
            if (defined $job->{drvPath}) {
                print STDERR "good job $name: "
                    . printStorePath(machineLocalStore()->storeDir, $job->{drvPath}) . "\n";
            } else {
                print STDERR "failed job $name: $job->{error}\n";
            }
        }
        return;
    }

    # Store the error messages for jobs that failed to evaluate.
    my $evaluationErrorTime = time;
    my $evaluationErrorMsg = "";
    my $evaluationErrorRecord = $db->resultset('EvaluationErrors')->create(
        { errormsg => $evaluationErrorMsg
        , errortime => $evaluationErrorTime
        }
    );

    my $jobOutPathMap = {};
    my $jobsetChanged = 0;
    my %buildMap;

    my @jobs;
    push @jobs, $_ while defined($_ = $jobsIter->());

    my $currentEval;
    my $evalTxn = sub {
        my $prevEval = getPrevJobsetEval($db, $jobset, 1);
        $currentEval = undef;

        # The evaluation already exists: scheduling the evaluation build
        # created it, so that it is visible while it runs. Fill it in rather
        # than making a second one.
        my $ev = $db->resultset('JobsetEvals')->find($evalId)
            or die "evaluation $evalId no longer exists\n";
        $ev->update(
            { evaluationerror => $evaluationErrorRecord
            , nrbuilds => 0
            , nixexprinput => $jobset->nixexprinput
            , nixexprpath => $jobset->nixexprpath
            });

        my @jobsWithConstituents;

        foreach my $job (@jobs) {
            if ($jobsetsJobset) {
                die "The .jobsets jobset must only have a single job named 'jobsets'"
                    unless $job->{attr} eq "jobsets";
            }

            $evaluationErrorMsg .=
                ($job->{attr} ne "" ? "in job ‘$job->{attr}’" : "at top-level") .
                ":\n" . $job->{error} . "\n\n" if defined $job->{error};

            checkBuild($db, $jobset, $ev, undef, $job, \%buildMap, $prevEval, $jobOutPathMap, $plugins)
                unless defined $job->{error};

            if (defined $job->{constituents}) {
                push @jobsWithConstituents, $job;
            }
        }

        # Bulk-insert the outputs of all new builds in one statement.
        # `populate` in void context goes through insert_bulk, which bypasses
        # inflation and deflation, so these paths stay as nix-eval-jobs gave
        # them: full path strings, or undef for a not-yet-built CA output.
        my @outputRows = map { @{$_->{outputs} // []} } values %buildMap;
        $db->resultset('BuildOutputs')->populate(\@outputRows) if @outputRows;

        # Have any builds been added or removed since last time?
        $jobsetChanged =
            (scalar(grep { $_->{new} } values(%buildMap)) > 0)
            || (defined $prevEval && $prevEval->jobsetevalmembers->count != scalar(keys %buildMap));

        $ev->update({
            hasnewbuilds => $jobsetChanged ? 1 : 0,
            nrbuilds => $jobsetChanged ? scalar(keys %buildMap) : undef
        });

        $db->storage->dbh->do("notify eval_added, ?", undef,
                              join("\t", $tmpId, $jobset->get_column('id'), $ev->id));

        if ($jobsetChanged) {
            # Create JobsetEvalMembers mappings in bulk.
            $db->resultset('JobsetEvalMembers')->populate(
                [ map { { eval => $ev->id, build => $_, isnew => $buildMap{$_}->{new} } } keys %buildMap ]);

            # Create AggregateConstituents mappings.  Since there can
            # be jobs that alias each other, if there are multiple
            # builds for the same derivation, pick the one with the
            # shortest name.
            my %drvPathToId;
            foreach my $id (keys %buildMap) {
                my $x = $buildMap{$id};
                my $y = $drvPathToId{$x->{drvPath}};
                if (defined $y) {
                    next if length $x->{jobName} > length $y->{jobName};
                    next if length $x->{jobName} == length $y->{jobName} && $x->{jobName} ge $y->{jobName};
                }
                $drvPathToId{$x->{drvPath}} = $x;
            }

            foreach my $job (values @jobsWithConstituents) {
                next unless defined $job->{constituents};
                if (defined $job->{error}) {
                    die "aggregate job ‘$job->{attr}’ failed with the error: $job->{error}\n";
                }

                my $x = $drvPathToId{$job->{drvPath}} or
                    die "aggregate job ‘$job->{attr}’ has no corresponding build record.\n";
                foreach my $drvPath (@{$job->{constituents}}) {
                    my $constituent = $drvPathToId{$drvPath};
                    if (defined $constituent) {
                        $db->resultset('AggregateConstituents')->update_or_create({aggregate => $x->{id}, constituent => $constituent->{id}});
                    } else {
                        warn "aggregate job ‘$job->{attr}’ has a constituent ‘$drvPath’ that doesn't correspond to a Hydra build\n";
                    }
                }
            }

            print STDERR "  created new eval ", $ev->id, "\n";
            $currentEval = $ev->id;

            # Wake up hydra-queue-runner.
            my $lowestId;
            foreach my $id (keys %buildMap) {
                my $x = $buildMap{$id};
                $lowestId = $id if $x->{new} && (!defined $lowestId || $id < $lowestId);
            }
            $notifyAdded->execute($lowestId) if defined $lowestId;

        } else {
            print STDERR "  created cached eval ", $ev->id, "\n";
            $currentEval = $prevEval->id if defined $prevEval;
        }

        # If this is a one-shot jobset, disable it now.
        $jobset->update({ enabled => 0 }) if $jobset->enabled == 2;

        $jobset->update({ lastcheckedtime => time, forceeval => undef });

        $evaluationErrorRecord->update({ errormsg => $evaluationErrorMsg });
        setJobsetError($jobset, $evaluationErrorMsg, $evaluationErrorTime);

        # How long evaluating took, which is how long the evaluation build
        # ran -- not how long this run took to read its output.
        #
        # `completed` goes in the same update: from here on the row's columns
        # are answers rather than placeholders, and that is exactly what the
        # column means.
        $ev->update({ evaltime => $evalSeconds, completed => time });
    };

    # Retry rather than lose the evaluation if Postgres aborts the transaction
    # to break a lock cycle with the queue runner.
    for (my $attempt = 1; ; $attempt++) {
        eval { $db->txn_do($evalTxn); };
        last unless $@;
        die $@ if $attempt >= 10 || $@ !~ /deadlock detected|could not serialize access/i;
        print STDERR "evaluation transaction aborted (attempt $attempt), retrying: $@";
        %buildMap = ();
        $jobOutPathMap = {};
        $jobsetChanged = 0;
        sleep $attempt;
    }

    applyDrvPathRepoints(\%buildMap);
    syncCurrentBuilds($jobset, $currentEval) if defined $currentEval;

    Net::Statsd::timing("hydra.evaluator.eval_time", $evalSeconds * 1000);
    Net::Statsd::increment("hydra.evaluator.evals");
    Net::Statsd::increment("hydra.evaluator.cached_evals") unless $jobsetChanged;
}



sub checkJobset {
    my ($jobset) = @_;

    my $startTime = clock_gettime(CLOCK_MONOTONIC);

    # Add an ID to eval_* notifications so receivers can correlate
    # them.
    my $tmpId = "${startTime}.$$";

    $db->storage->dbh->do("notify eval_started, ?", undef,
                          join("\t", $tmpId, $jobset->get_column('id')));

    eval {
        checkJobsetWrapped($jobset, $tmpId);
    };
    my $checkError = $@;

    my $stopTime = clock_gettime(CLOCK_MONOTONIC);
    Net::Statsd::timing("hydra.evaluator.total_time", int(($stopTime - $startTime) * 1000));

    my $failed = 0;
    if ($checkError) {
        print STDERR $checkError;
        my $eventTime = time;
        $db->txn_do(sub {
            $jobset->update({lastcheckedtime => $eventTime});
            setJobsetError($jobset, $checkError, $eventTime);
            $db->storage->dbh->do("notify eval_failed, ?", undef, join("\t", $tmpId, $jobset->get_column('id')));
        }) if !$dryRun;
        $failed = 1;
    }

    return $failed;
}


# Finish an evaluation whose evaluation build has completed: read the jobs
# from the build's output and turn them into the evaluation's members and
# their builds.
#
# The output is read rather than any live stream, because it is the only
# source that is always there. An evaluation whose derivation was built
# before is not rebuilt, so nothing streams, and the output remains.
sub finishScheduledEvaluation {
    my ($evalId) = @_;

    my $ev = $db->resultset('JobsetEvals')->find($evalId)
        or die "$0: evaluation $evalId does not exist\n";
    my $build = $ev->eval_build
        or die "$0: evaluation $evalId was not performed by a build\n";

    die "$0: evaluation build " . $build->id . " has not finished\n"
        unless $build->finished;

    if ($build->buildstatus != 0) {
        # Leave no tentative evaluation behind: its hash would otherwise say
        # these inputs had been evaluated, and the jobset would never retry.
        my $msg = "evaluation build " . $build->id . " failed";
        my $eventTime = time;
        my $jobset = $ev->jobset;
        $db->txn_do(sub {
            $ev->delete;
            setJobsetError($jobset, "$msg\n", $eventTime);
        });
        print STDERR "$msg\n";
        return 1;
    }

    my ($output) = $build->buildoutputs;
    die "$0: evaluation build " . $build->id . " produced no output\n"
        unless defined $output;

    # `path` is stored as a bare store path, so put the store dir back to get
    # something openable. The store's physical layout matches its logical one
    # here -- a relocated store is only relocated for the *clients* that pass
    # a root, and this is the store the build wrote into.
    my $outPath = printStorePath(machineLocalStore()->storeDir, $output->path);
    open(my $fh, "<", $outPath)
        or die "$0: cannot read the evaluation's jobs from $outPath: $!\n";

    my $jobsIter = jobsIterFromLines(sub {
        my $line = <$fh>;
        if (!defined $line) {
            close $fh;
            return undef;
        }
        chomp $line;
        return $line;
    });

    my $jobset = $ev->jobset;
    my $project = $jobset->project;
    my $tmpId = clock_gettime(CLOCK_MONOTONIC) . ".$$";

    # Evaluating took as long as the evaluation build ran.
    my $evalSeconds = defined $build->stoptime && defined $build->starttime
        ? abs($build->stoptime - $build->starttime) : 0;

    finishEvaluation($db, $plugins, $project, $jobset, $ev->id, $jobsIter,
                     $evalSeconds, $tmpId, 0);
    return 0;
}


if (@ARGV == 2 && $ARGV[0] eq "--finish-evaluation") {
    exit finishScheduledEvaluation($ARGV[1]);
}

die "syntax: $0 <PROJECT> <JOBSET>\n       $0 --finish-evaluation <EVAL-ID>\n"
    unless @ARGV == 2;

my $projectName = $ARGV[0];
my $jobsetName = $ARGV[1];
my $jobset = $db->resultset('Jobsets')->find($projectName, $jobsetName) or
    die "$0: specified jobset \"$projectName:$jobsetName\" does not exist\n";
exit checkJobset($jobset);
