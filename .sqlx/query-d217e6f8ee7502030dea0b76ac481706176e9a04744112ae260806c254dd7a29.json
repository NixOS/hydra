{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.jobset_id, e.trace_id, b.buildstatus as build_status,\n               o.path as out_path\n        FROM jobsetevals e\n        JOIN builds b ON e.eval_build = b.id\n        LEFT JOIN buildoutputs o ON o.build = b.id AND o.name = 'out'\n        WHERE e.id = $1",
