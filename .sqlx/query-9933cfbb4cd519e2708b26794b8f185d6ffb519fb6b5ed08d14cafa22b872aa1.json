{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.name, i.type, a.value, i.emailresponsible\n        FROM jobsetinputs i\n        LEFT JOIN jobsetinputalts a\n          ON a.project = i.project AND a.jobset = i.jobset AND a.input = i.name\n        WHERE i.project = $1 AND i.jobset = $2\n        ORDER BY i.name, a.altnr",
