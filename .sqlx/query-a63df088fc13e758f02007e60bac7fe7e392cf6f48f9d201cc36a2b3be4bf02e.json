  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.id, b.job, b.finished, b.drvpath, o.name, o.path as \"path?\"\n        FROM jobsetevalmembers m\n        JOIN builds b ON m.build = b.id\n        JOIN buildoutputs o ON o.build = b.id\n        WHERE m.eval = $1 AND b.jobset_id = $2",
