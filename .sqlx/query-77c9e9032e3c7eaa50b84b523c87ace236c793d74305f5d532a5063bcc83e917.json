{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.id, b.releasename, b.nixname, b.drvpath,\n               o.path as \"out_path?\", o.name as \"out_name?\"\n        FROM builds b\n        LEFT JOIN LATERAL (\n          SELECT path, name FROM buildoutputs WHERE build = b.id\n          ORDER BY name <> 'out', name LIMIT 1) o ON true\n        WHERE b.id = $1",
