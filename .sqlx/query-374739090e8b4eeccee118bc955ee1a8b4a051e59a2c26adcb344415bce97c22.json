  "query": "\n        SELECT j.id, j.flake, j.nixexprinput, j.nixexprpath, j.forceeval,\n               p.declfile, p.decltype, p.declvalue\n        FROM jobsets j\n        JOIN projects p ON j.project = p.name\n        WHERE j.project = $1 AND j.name = $2",
