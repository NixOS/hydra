  "query": "\n        SELECT b.id, b.releasename, b.nixname,\n               o.path as \"out_path?\", o.name as \"out_name?\"\n        FROM builds b\n        LEFT JOIN buildoutputs o ON o.build = b.id AND o.name = 'out'\n        WHERE b.id = $1",
