  "query": "\n            SELECT\n              j.id,\n              j.project,\n              j.name,\n              lastCheckedTime,\n              triggerTime,\n              checkInterval,\n              j.enabled\n            FROM jobsets j\n            JOIN projects p ON j.project = p.name\n            WHERE j.enabled != 0 AND p.enabled != 0",
