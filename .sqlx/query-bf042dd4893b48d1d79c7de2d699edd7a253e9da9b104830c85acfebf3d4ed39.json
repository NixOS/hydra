  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n              builds.id,\n              builds.jobset_id,\n              jobsets.project as project,\n              jobsets.name as jobset,\n              job,\n              drvPath,\n              storeDir,\n              maxsilent,\n              timeout,\n              timestamp,\n              globalPriority,\n              priority\n            FROM builds\n            INNER JOIN jobsets ON builds.jobset_id = jobsets.id\n            WHERE finished = 0 ORDER BY globalPriority desc, schedulingshares, random();",
